@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="card auth-card">
    <div class="auth-card-header">
        <div class="auth-icon"><i class="bi bi-key"></i></div>
        <h1>¿Olvidaste tu contraseña?</h1>
        <p>No te preocupes, te ayudamos a recuperarla</p>
    </div>

    <div class="auth-card-body">
        <partial name="_StatusMessage" />

        <p class="text-body-secondary small mb-4">
            Ingresa el correo con el que te registraste y te enviaremos un enlace para restablecer tu contraseña.
        </p>

        <form asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="form-floating mb-1">
                <input asp-for="Email" class="form-control" placeholder="nombre@correo.com" autocomplete="email" autofocus />
                <label asp-for="Email"></label>
            </div>
            <span asp-validation-for="Email" class="text-danger small d-block mb-4"></span>

            <button type="submit" class="btn btn-auth w-100">
                <i class="bi bi-send me-1"></i> Enviar enlace de recuperación
            </button>
        </form>
    </div>

    <div class="auth-card-footer">
        <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
    </div>
</div>
