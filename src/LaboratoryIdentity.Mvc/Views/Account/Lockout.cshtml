@{
    ViewData["Title"] = "Cuenta bloqueada";
}

<div class="card auth-card">
    <div class="auth-status">
        <div class="auth-status-icon is-warning"><i class="bi bi-lock-fill"></i></div>
        <h1>Cuenta bloqueada temporalmente</h1>
        <p>Detectamos demasiados intentos fallidos de inicio de sesión. Por seguridad, tu cuenta quedó bloqueada por unos minutos.</p>
        <p class="small">Intenta de nuevo más tarde o restablece tu contraseña.</p>

        <a asp-action="ForgotPassword" class="btn btn-auth w-100 mt-3">
            <i class="bi bi-key me-1"></i> Restablecer contraseña
        </a>
    </div>

    <div class="auth-card-footer">
        <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
    </div>
</div>
