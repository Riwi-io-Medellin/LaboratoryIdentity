@{
    ViewData["Title"] = "Revisa tu correo";
}

<div class="card auth-card">
    <div class="auth-status">
        <div class="auth-status-icon is-info"><i class="bi bi-envelope-check"></i></div>
        <h1>Revisa tu correo</h1>
        <p>Si existe una cuenta asociada a ese correo, recibirás un enlace para restablecer tu contraseña en los próximos minutos.</p>
        <p class="small">¿No lo ves? Revisa la carpeta de spam o correo no deseado.</p>

        <a asp-action="Login" class="btn btn-auth w-100 mt-3">
            <i class="bi bi-box-arrow-in-right me-1"></i> Volver a iniciar sesión
        </a>
    </div>

    <div class="auth-card-footer">
        ¿No recibiste nada? <a asp-action="ForgotPassword" class="auth-link">Intentar de nuevo</a>
    </div>
</div>
