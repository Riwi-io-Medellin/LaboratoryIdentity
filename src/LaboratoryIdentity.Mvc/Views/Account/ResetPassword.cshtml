@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="card auth-card">
    <div class="auth-card-header">
        <div class="auth-icon"><i class="bi bi-shield-lock"></i></div>
        <h1>Nueva contraseña</h1>
        <p>Elige una contraseña segura que no hayas usado antes</p>
    </div>

    <div class="auth-card-body">
        <partial name="_StatusMessage" />

        <form asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
            <input type="hidden" asp-for="Code" />

            <div class="form-floating mb-1">
                <input asp-for="Email" class="form-control" placeholder="nombre@correo.com" autocomplete="username" />
                <label asp-for="Email"></label>
            </div>
            <span asp-validation-for="Email" class="text-danger small d-block mb-3"></span>

            <div class="input-group">
                <div class="form-floating">
                    <input asp-for="Password" class="form-control" placeholder="Nueva contraseña" autocomplete="new-password" autofocus />
                    <label asp-for="Password"></label>
                </div>
                <button type="button" class="btn btn-toggle-password" data-toggle-password="Password" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small d-block mb-3"></span>

            <div class="input-group">
                <div class="form-floating">
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar nueva contraseña" autocomplete="new-password" />
                    <label asp-for="ConfirmPassword"></label>
                </div>
                <button type="button" class="btn btn-toggle-password" data-toggle-password="ConfirmPassword" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mb-4"></span>

            <button type="submit" class="btn btn-auth w-100">
                <i class="bi bi-check2-circle me-1"></i> Restablecer contraseña
            </button>
        </form>
    </div>

    <div class="auth-card-footer">
        <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
    </div>
</div>
