@{
    ViewData["Title"] = "Contraseña actualizada";
}

<div class="card auth-card">
    <div class="auth-status">
        <div class="auth-status-icon is-success"><i class="bi bi-check2-circle"></i></div>
        <h1>¡Contraseña actualizada!</h1>
        <p>Tu contraseña se cambió correctamente. La próxima vez que inicies sesión usa tu nueva contraseña.</p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-auth w-100 mt-3">
            <i class="bi bi-house me-1"></i> Volver al inicio
        </a>
    </div>
</div>
