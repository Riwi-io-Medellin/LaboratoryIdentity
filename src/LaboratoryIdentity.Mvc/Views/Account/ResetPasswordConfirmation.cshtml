@{
    ViewData["Title"] = "Contraseña restablecida";
}

<div class="card auth-card">
    <div class="auth-status">
        <div class="auth-status-icon is-success"><i class="bi bi-shield-check"></i></div>
        <h1>¡Contraseña restablecida!</h1>
        <p>Tu contraseña se actualizó correctamente. Ya puedes iniciar sesión con tu nueva contraseña.</p>

        <a asp-action="Login" class="btn btn-auth w-100 mt-3">
            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
        </a>
    </div>
</div>
