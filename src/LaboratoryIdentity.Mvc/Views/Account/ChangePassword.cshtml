@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="card auth-card">
    <div class="auth-card-header">
        <div class="auth-icon"><i class="bi bi-arrow-repeat"></i></div>
        <h1>Cambiar contraseña</h1>
        <p>Actualiza la contraseña de tu cuenta</p>
    </div>

    <div class="auth-card-body">
        <partial name="_StatusMessage" />

        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="input-group">
                <div class="form-floating">
                    <input asp-for="CurrentPassword" class="form-control" placeholder="Contraseña actual" autocomplete="current-password" autofocus />
                    <label asp-for="CurrentPassword"></label>
                </div>
                <button type="button" class="btn btn-toggle-password" data-toggle-password="CurrentPassword" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="CurrentPassword" class="text-danger small d-block mb-3"></span>

            <hr class="my-4 text-body-tertiary" />

            <div class="input-group">
                <div class="form-floating">
                    <input asp-for="NewPassword" class="form-control" placeholder="Nueva contraseña" autocomplete="new-password" />
                    <label asp-for="NewPassword"></label>
                </div>
                <button type="button" class="btn btn-toggle-password" data-toggle-password="NewPassword" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small d-block mb-3"></span>

            <div class="input-group">
                <div class="form-floating">
                    <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Confirmar nueva contraseña" autocomplete="new-password" />
                    <label asp-for="ConfirmNewPassword"></label>
                </div>
                <button type="button" class="btn btn-toggle-password" data-toggle-password="ConfirmNewPassword" aria-label="Mostrar contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmNewPassword" class="text-danger small d-block mb-4"></span>

            <button type="submit" class="btn btn-auth w-100">
                <i class="bi bi-check2-circle me-1"></i> Guardar nueva contraseña
            </button>
        </form>
    </div>

    <div class="auth-card-footer">
        <a asp-controller="Home" asp-action="Index" class="auth-link"><i class="bi bi-arrow-left me-1"></i>Volver al inicio</a>
    </div>
</div>
