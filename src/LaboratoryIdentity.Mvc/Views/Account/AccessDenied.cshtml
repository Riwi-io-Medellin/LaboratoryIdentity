@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="card auth-card">
    <div class="auth-status">
        <div class="auth-status-icon is-danger"><i class="bi bi-shield-x"></i></div>
        <h1>Acceso denegado</h1>
        <p>No tienes permisos para acceder a este recurso. Si crees que es un error, contacta al administrador.</p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-auth w-100 mt-3">
            <i class="bi bi-house me-1"></i> Volver al inicio
        </a>
    </div>
</div>
