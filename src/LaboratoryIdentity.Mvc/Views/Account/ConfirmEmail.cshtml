@model ConfirmEmailViewModel
@{
    ViewData["Title"] = Model.Succeeded ? "Cuenta verificada" : "Error de verificación";
}

<div class="card auth-card">
    @if (Model.Succeeded)
    {
        <div class="auth-status">
            <div class="auth-status-icon is-success"><i class="bi bi-patch-check-fill"></i></div>
            <h1>¡Cuenta verificada!</h1>
            <p>Tu correo electrónico fue confirmado correctamente. Ya puedes iniciar sesión.</p>

            <a asp-action="Login" class="btn btn-auth w-100 mt-3">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
            </a>
        </div>
    }
    else
    {
        <div class="auth-status">
            <div class="auth-status-icon is-danger"><i class="bi bi-x-octagon-fill"></i></div>
            <h1>No pudimos verificar tu cuenta</h1>
            <p>El enlace no es válido o ya expiró. Solicita un nuevo correo de confirmación.</p>

            <a asp-action="ResendEmailConfirmation" class="btn btn-auth w-100 mt-3">
                <i class="bi bi-envelope-arrow-up me-1"></i> Reenviar confirmación
            </a>
        </div>

        <div class="auth-card-footer">
            <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
        </div>
    }
</div>
