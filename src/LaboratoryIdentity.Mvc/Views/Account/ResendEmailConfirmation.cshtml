@model ResendEmailConfirmationViewModel
@{
    ViewData["Title"] = "Reenviar confirmación";
}

<div class="card auth-card">
    <div class="auth-card-header">
        <div class="auth-icon"><i class="bi bi-envelope-arrow-up"></i></div>
        <h1>Reenviar confirmación</h1>
        <p>Te enviaremos un nuevo enlace de verificación</p>
    </div>

    <div class="auth-card-body">
        <partial name="_StatusMessage" />

        <form asp-action="ResendEmailConfirmation" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="form-floating mb-1">
                <input asp-for="Email" class="form-control" placeholder="nombre@correo.com" autocomplete="email" autofocus />
                <label asp-for="Email"></label>
            </div>
            <span asp-validation-for="Email" class="text-danger small d-block mb-4"></span>

            <button type="submit" class="btn btn-auth w-100">
                <i class="bi bi-send me-1"></i> Reenviar correo
            </button>
        </form>
    </div>

    <div class="auth-card-footer">
        <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
    </div>
</div>
